# Pearl solo pool config (/etc/pearl-stratum-srv/env)
# chmod 600, owned root:pearl
# Required vars — service won't start without them.

# Pearl node RPC. CPU02 plaintext localhost is fine; for cross-host change to TLS+44107.
PEARL_SRV_RPC_URL=http://127.0.0.1:18334
PEARL_SRV_RPC_USER=rpcuser
PEARL_SRV_RPC_PASSWORD=CHANGE_ME_strong_random_password

# Coinbase recipient. Generate once with: `oyster-cli getnewaddress`
PEARL_SRV_MINING_ADDRESS=prl1pCHANGE_ME

# Optional overrides (defaults shown):
# PEARL_SRV_LISTEN_HOST=0.0.0.0
# PEARL_SRV_LISTEN_PORT=5566
# PEARL_SRV_METRICS_HOST=0.0.0.0
# PEARL_SRV_METRICS_PORT=9101
# PEARL_SRV_POLL_INTERVAL=2.0
# PEARL_SRV_METRICS_MAX_TEMPLATE_AGE_SECONDS=60
# PEARL_SRV_JOB_HISTORY_SIZE=16
# PEARL_SRV_DEBUG_VERIFY=false
