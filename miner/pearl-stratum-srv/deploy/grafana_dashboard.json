{
  "title": "Pearl solo pool — pearl-stratum-srv",
  "description": "Operator view for the Pearl solo mining pool. Optimized for the 36-rig fleet — the per-worker share rate panel is the load-bearing 'which rig is IDLE?' signal.",
  "tags": ["pearl", "mining", "solo-pool"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {"from": "now-3h", "to": "now"},
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Pool host",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(pearl_stratum_srv_connected_miners, instance)",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Connected miners",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "pearl_stratum_srv_connected_miners{instance=~\"$instance\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 1},
              {"color": "green", "value": 30}
            ]
          },
          "unit": "short"
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "auto"}
    },
    {
      "id": 2,
      "title": "Template height",
      "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "pearl_stratum_srv_template_height{instance=~\"$instance\"}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 3,
      "title": "Template age",
      "description": "Seconds since the last template was minted. Should be <60 — alphapool block time is ~93s observed, so anything over 120s means pearld stopped delivering.",
      "type": "gauge",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "pearl_stratum_srv_template_age_seconds{instance=~\"$instance\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 180,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 60},
              {"color": "red", "value": 120}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Blocks found (total)",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(pearl_stratum_srv_blocks_total{instance=~\"$instance\",outcome=\"accepted\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 1}]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "none"}
    },
    {
      "id": 5,
      "title": "Block errors (last 24h)",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(increase(pearl_stratum_srv_blocks_total{instance=~\"$instance\",outcome=\"error\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Jobs in registry",
      "type": "stat",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "pearl_stratum_srv_jobs_in_registry{instance=~\"$instance\"}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "title": "Share rate by worker (accepted shares/sec)",
      "description": "The load-bearing fleet-liveness signal. Each rig should sustain ~1 share/min/GPU at d=2^20. A worker dropping to zero for >120s = its alpha-miner stopped submitting — check rig.",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 10},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "rate(pearl_stratum_srv_shares_total{instance=~\"$instance\",outcome=\"accepted\"}[2m])",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never"}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"]}}
    },
    {
      "id": 8,
      "title": "Stale share rate by worker",
      "description": "Stales should be sporadic — sustained nonzero on a single worker indicates that worker is racing the chain (slow uplink, GPU lag).",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "rate(pearl_stratum_srv_shares_total{instance=~\"$instance\",outcome=\"stale\"}[5m])",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 9,
      "title": "Malformed share rate by worker",
      "description": "Should be zero. Sustained nonzero = miner is sending unparseable plain_proof — protocol drift or a bad miner build.",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "rate(pearl_stratum_srv_shares_total{instance=~\"$instance\",outcome=\"malformed\"}[5m])",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.001}]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Connected miners over time",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "pearl_stratum_srv_connected_miners{instance=~\"$instance\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "fillOpacity": 20, "lineWidth": 2}
        }
      }
    },
    {
      "id": 11,
      "title": "Template age over time",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "pearl_stratum_srv_template_age_seconds{instance=~\"$instance\"}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1}
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Block found",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "enable": true,
        "iconColor": "green",
        "expr": "changes(pearl_stratum_srv_blocks_total{instance=~\"$instance\",outcome=\"accepted\"}[1m]) > 0",
        "titleFormat": "Block found",
        "textFormat": "outcome={{outcome}}"
      }
    ]
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping pearl-stratum-srv :9101/metrics",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ]
}
